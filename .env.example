PORT=3847
SECRET_KEY=change-me
ALLOWED_ORIGINS=yourfrontend.com,localhost

# ─── Outbound proxies (optional) ─────────────────────────────────────────────
# One proxy per line: http://user:pass@host:port or user:pass@host:port.
# Git-ignored — copy it to the VPS by hand. Restart after editing.
UPSTREAM_PROXY_FILE=./proxies.txt

# By default every host goes DIRECT. A host that answers 429 is retried through
# a proxy and stays proxied for 10 minutes, then goes back to direct. A dead
# proxy is skipped for 30s and the request retries on the next one.
# Leave both filters below unset for that (recommended — fastest).
#
# Note: comments must be on their own line; text after a value is part of it.

# Force provider names through proxies ALWAYS (slower; segments too). * = everything.
# UPSTREAM_PROXY_SERVERS=koto,suge
# Force a host and its subdomains through proxies ALWAYS.
# UPSTREAM_PROXY_DOMAINS=cdn.example

# Instead of a file: a single proxy, or a comma-separated list.
# UPSTREAM_PROXY=http://user:pass@proxy.example:8080
# UPSTREAM_PROXIES=http://user:pass@a.example:8080,http://user:pass@b.example:8080

# ─── Capacity ────────────────────────────────────────────────────────────────
# Detected from RAM at startup. Leave overrides unset when moving VPSes.
STREAM_BUFFER_KB=256
# Default: half of RAM / ~1.5 MiB per stream. 0 = unlimited.
# MAX_CONCURRENT=1365
# Default: 0 (unlimited).
# MAX_CONNS_PER_HOST=0
# Default: RAM-derived, per transport.
# MAX_IDLE_CONNS=655
# Default: half of MAX_IDLE_CONNS.
# MAX_IDLE_CONNS_PER_HOST=327
# Default: 70% of detected RAM.
# GOMEMLIMIT=2800MiB
