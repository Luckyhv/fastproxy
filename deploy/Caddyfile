# Caddy reverse proxy in front of fastproxy.
#
# Uses the Cloudflare Origin Certificate already installed at
# /etc/ssl/cloudflare/, which pairs with Cloudflare SSL mode "Full (strict)".
# CF terminates the public TLS; this secures the CF<->origin hop and CF verifies
# the cert.
#
# (If you ever drop the origin cert, replace the `tls` line with `tls internal`
# and set Cloudflare SSL mode to "Full".)

{
	# Caddy's admin API only listens on localhost by default, but this box does
	# not need runtime config pushes. Disabling it removes one listening socket.
	admin off
}

{$PROXY_HOST:proxy.example.com} {
	tls /etc/ssl/cloudflare/cert.pem /etc/ssl/cloudflare/key.pem

	header {
		# Avoid advertising origin software through Cloudflare.
		-Server
	}

	reverse_proxy 127.0.0.1:3847 {
		# Caddy streams responses by default. Avoid request/response buffer
		# directives here; they add memory pressure for video traffic.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			keepalive 2m
		}

		# Preserve the client/proxy headers the app may need for logs/debugging.
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
