PORT=3847
BIND_ADDR=127.0.0.1
SECRET_KEY=change-me-use-the-same-value-on-both-servers

# Frontend domains allowed to embed/use the proxy. Subdomains are included.
# Empty = open, which is useful for testing but not for production.
ALLOWED_ORIGINS=yourfrontend.com,localhost


# Optional knobs:
# MAX_CONCURRENT=0
# Egress proxies for upstream video CDNs.
# UPSTREAM_PROXIES accepts comma/newline/space-separated entries.
# UPSTREAM_PROXY_FILE points at a file with one proxy per line.
# UPSTREAM_PROXY is still supported for one legacy proxy.
# Formats: http://user:pass@host:port, host:port, host:port:user:pass
# Default server routing targets uwu/kiwi/wave by provider key, not CDN host.
# Set UPSTREAM_PROXY_SERVERS=* to proxy every token that carries a server key.
# UPSTREAM_PROXY_DOMAINS is only a legacy fallback for old cached tokens without
# a server key.
# UPSTREAM_PROXIES=
# UPSTREAM_PROXY_FILE=/opt/fastproxy/proxies.txt
# UPSTREAM_PROXY=
# UPSTREAM_PROXY_SERVERS=uwu,kiwi,wave
# UPSTREAM_PROXY_DOMAINS=
# A proxy that fails is benched for a cooldown and skipped by the rotation
# until it expires. Accepts "90s"/"5m" or a bare number of seconds.
# UPSTREAM_PROXY_RATE_COOLDOWN=60s    # after a 429/403 from the upstream
# UPSTREAM_PROXY_ERROR_COOLDOWN=5m    # after a connection failure (dead exit)
# UPSTREAM_PROXY_5XX_COOLDOWN=15s     # after a 502/503/504 (usually the origin)
# INSECURE_TLS=0
# ALLOW_RAW_URL=1
